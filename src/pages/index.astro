---
import { getCollection } from "astro:content";
import "../styles/site.css";

const recipes = (await getCollection("recipes")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, "zh-CN")
);

const tags = Array.from(new Set(recipes.flatMap((recipe) => recipe.data.tags))).sort((a, b) =>
  a.localeCompare(b, "zh-CN")
);

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path.replace(/^\/+/, "")}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="一份慢慢长出来的私人菜谱。" />
    <title>我的厨房手札</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href={withBase("/")}>我的厨房手札</a>
      <nav class="site-nav" aria-label="主导航">
        <a href="#recipes">菜谱</a>
      </nav>
    </header>

    <main>
      <section class="hero" style={`--hero-image: url("${withBase('/images/hero-kitchen.svg')}")`}>
        <div class="hero__inner">
          <p class="eyebrow">Cookbook</p>
          <h1>会做的菜，慢慢收进来。</h1>
          <p>每道菜一份 Markdown 食谱，一张图，一组标签。想吃什么，点开就能做。</p>
        </div>
      </section>

      <section class="page-shell" id="recipes">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Recipes</p>
            <h2>全部菜谱</h2>
          </div>
          <p>{recipes.length} 道菜</p>
        </div>

        <div class="tag-bar" aria-label="按标签筛选菜谱">
          <button class="tag-button is-active" type="button" data-filter="all">全部</button>
          {tags.map((tag) => <button class="tag-button" type="button" data-filter={tag}>{tag}</button>)}
        </div>

        <div class="recipe-grid" aria-live="polite">
          {
            recipes.map((recipe) => (
              <article class="recipe-card" data-tags={recipe.data.tags.join("|")}>
                <a href={withBase(`/recipes/${recipe.id}/`)} class="recipe-card__link">
                  <div class="recipe-card__image-wrap">
                    <img src={withBase(recipe.data.image)} alt={recipe.data.title} class="recipe-card__image" />
                  </div>
                  <div class="recipe-card__body">
                    <div class="recipe-card__meta">
                      {recipe.data.time && <span>{recipe.data.time}</span>}
                      {recipe.data.difficulty && <span>{recipe.data.difficulty}</span>}
                    </div>
                    <h3>{recipe.data.title}</h3>
                    {recipe.data.summary && <p>{recipe.data.summary}</p>}
                    <div class="recipe-card__tags" aria-label={`${recipe.data.title} 的标签`}>
                      {recipe.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
                    </div>
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        <p class="empty-state" hidden>这个标签下面还没有菜。</p>
      </section>
    </main>

    <footer class="site-footer">慢慢做，慢慢记。</footer>

    <script>
      const filterButtons = document.querySelectorAll("[data-filter]");
      const recipeCards = document.querySelectorAll(".recipe-card");
      const emptyState = document.querySelector(".empty-state");

      function setActiveFilter(tag) {
        let visibleCount = 0;

        filterButtons.forEach((button) => {
          button.classList.toggle("is-active", button.dataset.filter === tag);
        });

        recipeCards.forEach((card) => {
          const tags = card.dataset.tags.split("|");
          const shouldShow = tag === "all" || tags.includes(tag);
          card.hidden = !shouldShow;
          if (shouldShow) visibleCount += 1;
        });

        if (emptyState) emptyState.hidden = visibleCount !== 0;
      }

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const tag = button.dataset.filter;
          setActiveFilter(tag);
          const hash = tag === "all" ? "" : `#${encodeURIComponent(tag)}`;
          history.replaceState(null, "", `${location.pathname}${hash}`);
        });
      });

      const initialTag = decodeURIComponent(location.hash.replace("#", ""));
      if (initialTag && Array.from(filterButtons).some((button) => button.dataset.filter === initialTag)) {
        setActiveFilter(initialTag);
      }
    </script>
  </body>
</html>
